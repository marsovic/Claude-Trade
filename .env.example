# =============================================================================
# Survival trading bot - configuration template
# Copy to `.env` and edit. NEVER commit your real `.env` (it is git-ignored).
# Every variable is optional: the defaults below are what the bot uses.
# =============================================================================

# --- Exchange ---------------------------------------------------------------
# binance  : Binance USDⓈ-M futures (long/short, leverage up to MAX_LEVERAGE)
# revolutx : Revolut X spot, EUR pairs, long only, no leverage (see README)
EXCHANGE=binance

# --- Mode -------------------------------------------------------------------
# paper   : real market data, simulated orders (default; no key needed on
#           Binance, the Revolut X key IS needed: its market data is private)
# testnet : Binance futures testnet (https://testnet.binancefuture.com)
# live    : REAL MONEY. Also requires LIVE_TRADING=I_UNDERSTAND_THE_RISKS
MODE=paper
LIVE_TRADING=

# Use one state directory per mode (paper / testnet / live never share state).
STATE_DIR=state

# --- Binance API keys (testnet / live only) --------------------------------
# Create a key WITH futures trading and WITHOUT withdrawal permission, and
# restrict it to your IP. In live mode the bot refuses keys that can withdraw.
# Use a dedicated sub-account funded with the amount you accept to lose.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: override the REST endpoint (e.g. https://demo-fapi.binance.com)
FUTURES_BASE_URL=

# --- Revolut X (EXCHANGE=revolutx) ---------------------------------------------
# Ed25519 key pair: openssl genpkey -algorithm ed25519 -out revx_private.pem
# (chmod 600), register the public key at exchange.revolut.com > Profile >
# API Keys and whitelist your IP. Empty = the revx CLI / MCP config folder
# (~/.config/revolut-x). With revolutx, QUOTE_ASSET defaults to EUR, FEE_RATE to
# 0.0009, MAX_LEVERAGE is forced to 1 and pairs under MIN_QUOTE_VOLUME are skipped.
REVX_API_KEY=
REVX_PRIVATE_KEY_PATH=
# IOC entry limit = ask + this fraction
REVX_ENTRY_SLIPPAGE=0.003
# Minimum 24 h volume in the quote currency (revolutx default: 50000)
MIN_QUOTE_VOLUME=

# --- Capital & survival rule -------------------------------------------------
INITIAL_CAPITAL=50
# At or below this equity the capital is considered lost: the bot closes
# everything, writes STATE_DIR/TOMBSTONE.json and never trades again.
SURVIVAL_FLOOR=5

# --- Universe ---------------------------------------------------------------
UNIVERSE_SIZE=40
INTERVAL=15m
EXCLUDE_SYMBOLS=USDCUSDT,FDUSDUSDT,BTCDOMUSDT,DEFIUSDT

# --- Risk -------------------------------------------------------------------
RISK_PER_TRADE=0.02
MAX_LEVERAGE=5
# leverage = LEVERAGE_VOL_TARGET / ATR% (clamped to 1..MAX_LEVERAGE)
LEVERAGE_VOL_TARGET=3.0
STOP_ATR_MULT=1.5
TAKE_PROFIT_R=2.0
TRAILING=true
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.06
MARGIN_TYPE=ISOLATED

# --- Sentiment ----------------------------------------------------------------
# Fear & Greed (alternative.me) and CoinGecko trending work without any key.
SENTIMENT_ENABLED=true
SENTIMENT_VETO=0.25
# https://cryptopanic.com/developers/api/  (free developer plan)
CRYPTOPANIC_TOKEN=
# X API v2 bearer token (recent search needs a paid X API tier)
X_BEARER_TOKEN=
# Optional CoinGecko demo key (higher rate limit)
COINGECKO_API_KEY=

# --- Dashboard ----------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050

# =============================================================================
# INVESTMENT BOT (stocks & ETPs, no crypto) - see README_INVEST.md
# Settings use the INV_ prefix; provider keys keep their usual names.
# =============================================================================
# sim | trading212 | ibkr | alpaca          paper | live
INV_BROKER=sim
INV_ENVIRONMENT=paper
# Real money stays locked unless this equals I_UNDERSTAND_THE_RISKS
# (or pass --i-understand-the-risks). Separate from the crypto bot's LIVE_TRADING.
INV_LIVE_TRADING=
INV_STATE_DIR=state_invest

# --- Strategy ---------------------------------------------------------------------------
# insider = buy after SEC insider purchases, sell 20 sessions later: the rule validated
# by `python -m invest.events` (README_INVEST.md, section 7). momentum = the original
# breakout bot, which showed no edge (section 6). Needs SEC_USER_AGENT below.
INV_STRATEGY=insider
INV_INSIDER_RULES=ceo_cfo,conviction,buy
INV_INSIDER_SLOTS=4
INV_INSIDER_HOLD_DAYS=20
INV_INSIDER_STOP_PCT=0.35
INV_INITIAL_CAPITAL=100
INV_SURVIVAL_FLOOR=10
# Trading 212 forbids algorithmic trading with its own AI tool (MiFID II):
# set to true only once Trading 212 has agreed in writing to your bot.
INV_T212_TERMS_ACKNOWLEDGED=false

# --- Broker keys --------------------------------------------------------------
T212_API_KEY=
T212_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=
# IBKR: run IB Gateway (paper 4002 / live 4001) and `pip install ib_async`
IBKR_HOST=127.0.0.1
IBKR_PORT=
# Leveraged ETP on a real broker (EU-listed, after the broker's appropriateness
# test): the instrument to trade (Trading 212 ticker from its instrument list, or
# SYMBOL:EXCHANGE:CURRENCY for IBKR), its Alpha Vantage symbol for daily prices
# (needs ALPHAVANTAGE_API_KEY) and its currency. Empty = sleeve only in simulation.
INV_ETP_BROKER_TICKER=
INV_ETP_PRICE_SYMBOL=
INV_ETP_CURRENCY=EUR

# --- Data & research ---------------------------------------------------------------
# massive | alpaca | tiingo | csv
INV_DATA_PROVIDER=massive
MASSIVE_API_KEY=
TIINGO_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
# Required by the SEC for EDGAR (insider buying, and `python -m invest.events`):
# "Your Name your@email". Also sent to Wikimedia by `python -m invest.attention wiki`.
SEC_USER_AGENT=

# --- Aggressiveness (defaults shown) ----------------------------------------------
INV_RISK_PER_TRADE=0.04
INV_SLOTS=3
INV_MAX_WEIGHT=0.40
# At most this many positions in one theme (AI chips, software, ...): 3 slots must not
# become one bet. 0 = no limit.
INV_MAX_PER_THEME=1
# Trailing-stop distance in ATR (0 = same as the initial 3 ATR stop). Test 4 on a long
# history before changing it.
INV_TRAIL_ATR_MULT=0
# The 3x ETP sleeve is OFF until it passes its own out-of-sample test.
INV_ETP_ENABLED=false
INV_ETP_LEVERAGE=3
