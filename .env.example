# =============================================================================
# Survival trading bot - configuration template
# Copy to `.env` and edit. NEVER commit your real `.env` (it is git-ignored).
# Every variable is optional: the defaults below are what the bot uses.
# =============================================================================

# --- Mode -------------------------------------------------------------------
# paper   : real market data, simulated orders (default, no key needed)
# testnet : Binance futures testnet (https://testnet.binancefuture.com)
# live    : REAL MONEY. Also requires LIVE_TRADING=I_UNDERSTAND_THE_RISKS
MODE=paper
LIVE_TRADING=

# Use one state directory per mode (paper / testnet / live never share state).
STATE_DIR=state

# --- Binance API keys (testnet / live only) --------------------------------
# Create a key WITH futures trading and WITHOUT withdrawal permission, and
# restrict it to your IP. In live mode the bot refuses keys that can withdraw.
# Use a dedicated sub-account funded with the amount you accept to lose.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: override the REST endpoint (e.g. https://demo-fapi.binance.com)
FUTURES_BASE_URL=

# --- Capital & survival rule -------------------------------------------------
INITIAL_CAPITAL=50
# At or below this equity the capital is considered lost: the bot closes
# everything, writes STATE_DIR/TOMBSTONE.json and never trades again.
SURVIVAL_FLOOR=5

# --- Universe ---------------------------------------------------------------
UNIVERSE_SIZE=40
INTERVAL=15m
EXCLUDE_SYMBOLS=USDCUSDT,FDUSDUSDT,BTCDOMUSDT,DEFIUSDT

# --- Risk -------------------------------------------------------------------
RISK_PER_TRADE=0.02
MAX_LEVERAGE=5
# leverage = LEVERAGE_VOL_TARGET / ATR% (clamped to 1..MAX_LEVERAGE)
LEVERAGE_VOL_TARGET=3.0
STOP_ATR_MULT=1.5
TAKE_PROFIT_R=2.0
TRAILING=true
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.06
MARGIN_TYPE=ISOLATED

# --- Sentiment ----------------------------------------------------------------
# Fear & Greed (alternative.me) and CoinGecko trending work without any key.
SENTIMENT_ENABLED=true
SENTIMENT_VETO=0.25
# https://cryptopanic.com/developers/api/  (free developer plan)
CRYPTOPANIC_TOKEN=
# X API v2 bearer token (recent search needs a paid X API tier)
X_BEARER_TOKEN=
# Optional CoinGecko demo key (higher rate limit)
COINGECKO_API_KEY=

# --- Dashboard ----------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
